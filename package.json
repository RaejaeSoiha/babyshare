{
    "name": "lan-file-share",
    "version": "2.0.0",
    "description": "LAN/Online File Sharing with Encryption and Guest Access",
    "main": "src/server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "client:dev": "npm run dev --prefix client",
        "client:build": "npm run build --prefix client",
        "build": "npm run client:build",
        "sidecar:build": "node scripts/build-sidecar.js",
        "test": "node --test"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.6.1",
        "express": "^5.2.1",
        "express-session": "^1.18.2",
        "helmet": "^8.1.0",
        "multer": "^2.4.0",
        "qrcode": "^1.5.4",
        "session-file-store": "^1.5.0"
    },
    "devDependencies": {
        "nodemon": "^3.1.0",
        "pkg": "^5.8.1"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true
}
