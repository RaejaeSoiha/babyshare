# Copy to .env on the production host. Never commit the populated file.
NODE_ENV=production
BBS_DATA_DIR=/data

# The public HTTPS hostname (no trailing slash) used in links, QR codes, and cookies.
PUBLIC_BASE_URL=https://share.example.com
PUBLIC_HOST=share.example.com
ACME_EMAIL=ops@example.com

# Generate separate values with at least 32 random characters. Do not rotate FILE_KEY
# until every existing upload has been deliberately re-encrypted.
SESSION_SECRET=replace-with-a-unique-random-32-character-minimum-secret
FILE_KEY=replace-with-a-unique-random-32-character-minimum-file-encryption-key

# Caddy terminates TLS and is the only public listener. BabyShare remains loopback-only.
TRUST_PROXY=true
FORCE_HTTPS=false
BIND_HOST=127.0.0.1
PORT=3000
HTTP_PORT=3000
SESSION_MAX_AGE_MS=28800000

# LAN announcements point devices to Caddy's HTTPS listener. This requires a Linux LAN host
# with host networking and a hostname that nearby devices can resolve and trust.
LAN_DISCOVERY_PROTOCOL=https
LAN_DISCOVERY_PORT=443
WEBRTC_SIGNALING_ENABLED=true

# Leave empty for the recommended single-origin deployment. For a separately hosted frontend,
# set this to its exact HTTPS origin and set VITE_API_BASE at frontend build time.
# FRONTEND_BASE_URL=https://app.example.com
