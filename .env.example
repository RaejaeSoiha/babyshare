# For production, start with .env.production.example. Generate distinct 32+ character values.
SESSION_SECRET=replace-with-a-random-32-character-minimum-session-secret
FILE_KEY=replace-with-a-random-32-character-minimum-file-encryption-key

# Public HTTPS URL used in generated links and QR codes.
PUBLIC_BASE_URL=https://share.example.com

# Run behind an HTTPS reverse proxy that sets X-Forwarded-Proto.
TRUST_PROXY=true
FORCE_HTTPS=false
BIND_HOST=0.0.0.0
PORT=3000
HTTP_PORT=3000
SESSION_MAX_AGE_MS=28800000

# Optional separate frontend: must be its exact HTTPS origin in production.
# FRONTEND_BASE_URL=https://app.example.com

# The public Caddy deployment advertises HTTPS on 443 to LAN peers.
LAN_DISCOVERY_PROTOCOL=http
LAN_DISCOVERY_PORT=3000
WEBRTC_SIGNALING_ENABLED=true
